//@version=5
indicator("Eagle Eye [TLB]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ========================================================================= //
// =============================== INPUTS ================================== //
// ========================================================================= //

// --- POSITIONING ---
grp_pos = "POSITIONING"
i_hPos    = input.string("Right", "Horizontal Position", options=["Left","Right"], group=grp_pos, tooltip="Right = future space after last bar. Left = over historical bars.")
i_vPos    = input.string("Top",   "Vertical Position",   options=["Top","Middle","Bottom"], group=grp_pos, tooltip="Anchor the grid to the top, middle, or bottom of the visible range.")
i_width   = input.int(50,   "Mini Chart Width (Bars)", group=grp_pos)
i_offset  = input.int(6,    "Horizontal Offset",       group=grp_pos, tooltip="Bars away from last candle (Right) or bars back from last candle (Left).")
i_gapX    = input.int(10,    "Horizontal Gap (Bars)",   group=grp_pos)
i_vScale  = input.float(35.0, "Overall Height Scale",    group=grp_pos, step=0.1)
i_vBuffer = input.float(0.02,"Vertical Buffer (%)",     group=grp_pos, step=0.01)
i_vNudge  = input.float(0.0, "Vertical Nudge (%)",      group=grp_pos, step=0.01, tooltip="Fine-tune vertical offset. Positive = up, Negative = down. Expressed as % of visible range.")

// --- TIMEFRAMES & CANDLES (with per-TF toggle) ---
grp_tf = "CUSTOM TIMEFRAMES & CANDLES"
tf1_on = input.bool(true,    "TF 1", inline="tf1", group=grp_tf)
tf1    = input.timeframe("5",   "",   inline="tf1", group=grp_tf)
len1   = input.int(20, "",           inline="tf1", group=grp_tf)

tf2_on = input.bool(true,    "TF 2", inline="tf2", group=grp_tf)
tf2    = input.timeframe("15",  "",   inline="tf2", group=grp_tf)
len2   = input.int(20, "",           inline="tf2", group=grp_tf)

tf3_on = input.bool(true,    "TF 3", inline="tf3", group=grp_tf)
tf3    = input.timeframe("60",  "",   inline="tf3", group=grp_tf)
len3   = input.int(20, "",           inline="tf3", group=grp_tf)

tf4_on = input.bool(true,    "TF 4", inline="tf4", group=grp_tf)
tf4    = input.timeframe("240", "",   inline="tf4", group=grp_tf)
len4   = input.int(20, "",           inline="tf4", group=grp_tf)

tf5_on = input.bool(true,    "TF 5", inline="tf5", group=grp_tf)
tf5    = input.timeframe("D",   "",   inline="tf5", group=grp_tf)
len5   = input.int(15, "",           inline="tf5", group=grp_tf)

tf6_on = input.bool(true,    "TF 6", inline="tf6", group=grp_tf)
tf6    = input.timeframe("W",   "",   inline="tf6", group=grp_tf)
len6   = input.int(10, "",           inline="tf6", group=grp_tf)

// --- STYLE ---
grp_style = "STYLE"
c_up     = input.color(color.new(color.white, 0), "Up Color",         group=grp_style)
c_down   = input.color(color.new(color.gray, 0),  "Down Color",       group=grp_style)
c_bg     = input.color(color.new(#1a1a1a, 80),    "Background Color", group=grp_style)
c_border = input.color(color.new(#1a1a1a, 50),    "Border Color",     group=grp_style)
c_text   = input.color(color.new(color.gray, 0),  "Text Color",       group=grp_style)

// --- MOVING AVERAGES ---
grp_ma = "MOVING AVERAGES"
show_ma1 = input.bool(true,    "MA 1",   inline="ma1", group=grp_ma)
ma1_type = input.string("EMA", "",       inline="ma1", group=grp_ma, options=["EMA","SMA","WMA","HMA","DEMA","TEMA","SMMA"])
ma1_len  = input.int(9,        "Length", inline="ma1", group=grp_ma, minval=1)
c_ma1    = input.color(color.new(#00e5ff, 0), "", inline="ma1", group=grp_ma)

show_ma2 = input.bool(true,    "MA 2",   inline="ma2", group=grp_ma)
ma2_type = input.string("EMA", "",       inline="ma2", group=grp_ma, options=["EMA","SMA","WMA","HMA","DEMA","TEMA","SMMA"])
ma2_len  = input.int(21,       "Length", inline="ma2", group=grp_ma, minval=1)
c_ma2    = input.color(color.new(#ff9800, 0), "", inline="ma2", group=grp_ma)

// --- FVG ---
grp_fvg = "FVG SETTINGS"
show_fvg   = input.bool(true, "Show FVGs", group=grp_fvg)
c_fvg_bull = input.color(color.new(color.green, 80), "Bullish FVG", group=grp_fvg)
c_fvg_bear = input.color(color.new(color.red,   80), "Bearish FVG", group=grp_fvg)
max_fvg    = input.int(3, "Max Per Chart", group=grp_fvg)

// --- SUPPLY & DEMAND ---
grp_snd = "SUPPLY & DEMAND"
show_snd     = input.bool(true, "Show S&D Zones", group=grp_snd, tooltip="Detects base + leg-out zones using V10.0 SnD logic. Zones are mitigated on first wick touch.")
c_snd_demand = input.color(color.new(#00C853, 75), "Demand Zone",  group=grp_snd)
c_snd_supply = input.color(color.new(#FF1744, 75), "Supply Zone",  group=grp_snd)
snd_legMult  = input.float(1.2, "Leg-Out Multiplier", minval=1.0, maxval=3.0, step=0.1, group=grp_snd, tooltip="Leg-out body must be at least this × base body.")
max_snd      = input.int(2, "Max Zones Per Side", minval=1, maxval=4, group=grp_snd, tooltip="Max demand + max supply zones shown per mini chart.")
show_snd_price = input.bool(true, "Show Zone Prices", group=grp_snd, tooltip="Display the proximal (entry) price level on each S&D zone.")
snd_price_size = input.string("Tiny", "Price Label Size", options=["Tiny","Small","Normal","Large"], group=grp_snd)

// --- CANDLE RANGE HIGHLIGHTER ---
grp_range = "CANDLE RANGE HIGHLIGHTER"
show_range   = input.bool(false, "Highlight Candles by Range", group=grp_range, tooltip="Colors mini chart candles based on body-to-range ratio.\nRange 1: 0–50%  ·  Range 2: 50–70%  ·  Range 3: 70–100%")
c_r2_up      = input.color(color.new(#00BCD4, 0), "Range 2 Up",   inline="r2", group=grp_range)
c_r2_down    = input.color(color.new(#795548, 0), "Down",          inline="r2", group=grp_range)
c_r3_up      = input.color(color.new(#00E676, 0), "Range 3 Up",   inline="r3", group=grp_range)
c_r3_down    = input.color(color.new(#FF1744, 0), "Down",          inline="r3", group=grp_range)


// ========================================================================= //
// ============================ DATA FETCHING ============================== //
// ========================================================================= //

type HTF_Data
    array<float> o
    array<float> h
    array<float> l
    array<float> c

f_get_htf_data(tf, length) =>
    var float[] o_arr = array.new_float(0)
    var float[] h_arr = array.new_float(0)
    var float[] l_arr = array.new_float(0)
    var float[] c_arr = array.new_float(0)
    [o, h, l, c] = request.security(syminfo.tickerid, tf, [open, high, low, close])
    if ta.change(time(tf)) != 0
        array.push(o_arr, o[1])
        array.push(h_arr, h[1])
        array.push(l_arr, l[1])
        array.push(c_arr, c[1])
        if array.size(o_arr) > length
            array.shift(o_arr)
            array.shift(h_arr)
            array.shift(l_arr)
            array.shift(c_arr)
    HTF_Data.new(o_arr, h_arr, l_arr, c_arr)

// NOTE: request.security is evaluated at compile time, so all 6 calls remain
// regardless of toggle state. This is a Pine limitation, not a bug.
data1 = f_get_htf_data(tf1, len1)
data2 = f_get_htf_data(tf2, len2)
data3 = f_get_htf_data(tf3, len3)
data4 = f_get_htf_data(tf4, len4)
data5 = f_get_htf_data(tf5, len5)
data6 = f_get_htf_data(tf6, len6)


// ========================================================================= //
// ========================= MA HELPERS & DISPATCH ========================= //
// ========================================================================= //

f_ema_pass(float[] src, float k) =>
    int     n   = array.size(src)
    float[] out = array.new_float(n, na)
    if n > 0
        float prev = array.get(src, 0)
        array.set(out, 0, prev)
        for i = 1 to n - 1
            float v = array.get(src, i)
            float e = not na(v) and not na(prev) ? v * k + prev * (1.0 - k) : prev
            array.set(out, i, e)
            prev := e
    out

f_wma_pass(float[] src, int length) =>
    int     n   = array.size(src)
    float[] out = array.new_float(n, na)
    for i = length - 1 to n - 1
        float wsum = 0.0, ws = 0.0
        for j = 0 to length - 1
            float v = array.get(src, i - j)
            if not na(v)
                float w = length - j
                wsum += v * w
                ws   += w
        if ws > 0
            array.set(out, i, wsum / ws)
    out

f_calc_ma(float[] closes, string ma_type, int length) =>
    int     n   = array.size(closes)
    float[] out = array.new_float(n, na)
    if n > 0
        if ma_type == "SMA"
            for i = length - 1 to n - 1
                float s = 0.0
                for j = i - length + 1 to i
                    s += array.get(closes, j)
                array.set(out, i, s / length)
        else if ma_type == "EMA"
            out := f_ema_pass(closes, 2.0 / (length + 1))
        else if ma_type == "WMA"
            out := f_wma_pass(closes, length)
        else if ma_type == "SMMA"
            float val = na, float sm = 0.0, int cnt = 0
            for i = 0 to n - 1
                float v = array.get(closes, i)
                if na(val)
                    sm  += v
                    cnt += 1
                    if cnt >= length
                        val := sm / length
                        array.set(out, i, val)
                else
                    val := (val * (length - 1) + v) / length
                    array.set(out, i, val)
        else if ma_type == "DEMA"
            float k    = 2.0 / (length + 1)
            float[] e1 = f_ema_pass(closes, k)
            float[] e2 = f_ema_pass(e1, k)
            for i = 0 to n - 1
                float v1 = array.get(e1, i), float v2 = array.get(e2, i)
                if not na(v1) and not na(v2)
                    array.set(out, i, 2.0 * v1 - v2)
        else if ma_type == "TEMA"
            float k    = 2.0 / (length + 1)
            float[] e1 = f_ema_pass(closes, k)
            float[] e2 = f_ema_pass(e1, k)
            float[] e3 = f_ema_pass(e2, k)
            for i = 0 to n - 1
                float v1 = array.get(e1, i)
                float v2 = array.get(e2, i)
                float v3 = array.get(e3, i)
                if not na(v1) and not na(v2) and not na(v3)
                    array.set(out, i, 3.0 * v1 - 3.0 * v2 + v3)
        else if ma_type == "HMA"
            int half  = math.max(1, int(length / 2))
            int sq    = math.max(1, int(math.sqrt(length)))
            float[] wh = f_wma_pass(closes, half)
            float[] wf = f_wma_pass(closes, length)
            float[] df = array.new_float(n, na)
            for i = 0 to n - 1
                float vh = array.get(wh, i), float vf = array.get(wf, i)
                if not na(vh) and not na(vf)
                    array.set(df, i, 2.0 * vh - vf)
            out := f_wma_pass(df, sq)
    out


// ========================================================================= //
// =================== S&D ZONE DETECTION (Simplified V10.0) =============== //
// ========================================================================= //
// Uses the same base + leg-out logic as V10.0 SnD:
//   Base candle:    body ratio < 70% (Range 1 or 2)
//   Leg-out candle: body ratio >= 70% (Range 3 / explosive)
//   Leg-out body >= snd_legMult × base body
// Mitigation: fresh-zone mode — zone removed on first wick touch of proximal,
//             or invalidated if price goes beyond distal.

f_detect_snd(HTF_Data data) =>
    int n = array.size(data.c)
    float[] z_top    = array.new_float()
    float[] z_btm    = array.new_float()
    bool[]  z_isDem  = array.new_bool()
    int[]   z_barIdx = array.new_int()

    for i = 0 to n - 1
        float _o = array.get(data.o, i)
        float _h = array.get(data.h, i)
        float _l = array.get(data.l, i)
        float _c = array.get(data.c, i)

        // --- Step 1: Mitigate / invalidate existing zones with current bar ---
        int zCount = array.size(z_top)
        if zCount > 0
            for j = zCount - 1 to 0
                int zbi = array.get(z_barIdx, j)
                // Only check bars AFTER the zone was created
                if i > zbi
                    bool zd  = array.get(z_isDem, j)
                    bool kill = false
                    if zd
                        // Demand proximal = zone top; kill if wick reaches it
                        float zt = array.get(z_top, j)
                        if _l <= zt
                            kill := true
                    else
                        // Supply proximal = zone btm; kill if wick reaches it
                        float zb = array.get(z_btm, j)
                        if _h >= zb
                            kill := true
                    if kill
                        array.remove(z_top, j)
                        array.remove(z_btm, j)
                        array.remove(z_isDem, j)
                        array.remove(z_barIdx, j)

        // --- Step 2: Detect new zone (current bar = leg-out, prev = base) ---
        if i >= 1
            float _body  = math.abs(_c - _o)
            float _range = _h - _l
            float _ratio = _range > 0 ? (_body / _range) * 100.0 : 0.0

            if _ratio >= 70.0
                float _bo     = array.get(data.o, i - 1)
                float _bh     = array.get(data.h, i - 1)
                float _bl     = array.get(data.l, i - 1)
                float _bc     = array.get(data.c, i - 1)
                float _bBody  = math.abs(_bc - _bo)
                float _bRange = _bh - _bl
                float _bRatio = _bRange > 0 ? (_bBody / _bRange) * 100.0 : 0.0

                // Base must be Range 1 or 2 (< 70%), leg-out body >= mult × base
                if _bRatio < 70.0 and _body >= _bBody * snd_legMult
                    if _c > _o  // Bullish leg-out → demand zone
                        array.push(z_top,    math.max(_bo, _bc))
                        array.push(z_btm,    _bl)
                        array.push(z_isDem,  true)
                        array.push(z_barIdx, i)
                    if _c < _o  // Bearish leg-out → supply zone
                        array.push(z_top,    _bh)
                        array.push(z_btm,    math.min(_bo, _bc))
                        array.push(z_isDem,  false)
                        array.push(z_barIdx, i)

    [z_top, z_btm, z_isDem, z_barIdx]


// ========================================================================= //
// =========================== DRAWING LOGIC =============================== //
// ========================================================================= //

var box[]   bg_boxes  = array.new_box()
var box[]   candle_b  = array.new_box()
var line[]  candle_w  = array.new_line()
var box[]   fvg_boxes = array.new_box()
var line[]  ma1_lines = array.new_line()
var line[]  ma2_lines = array.new_line()
var box[]   snd_boxes  = array.new_box()
var label[] snd_labels = array.new_label()

f_cleanup() =>
    for b in bg_boxes
        box.delete(b)
    for b in candle_b
        box.delete(b)
    for l in candle_w
        line.delete(l)
    for b in fvg_boxes
        box.delete(b)
    for l in ma1_lines
        line.delete(l)
    for l in ma2_lines
        line.delete(l)
    for b in snd_boxes
        box.delete(b)
    for l in snd_labels
        label.delete(l)
    array.clear(bg_boxes),  array.clear(candle_b),  array.clear(candle_w)
    array.clear(fvg_boxes), array.clear(ma1_lines), array.clear(ma2_lines)
    array.clear(snd_boxes), array.clear(snd_labels)

f_format_tf(string tf) =>
    num = str.tonumber(tf)
    if not na(num)
        num >= 60 ? str.tostring(int(num / 60)) + "h" : str.tostring(int(num)) + "m"
    else
        tf

// ========================================================================= //
// ======================= DRAWING BUDGET TRACKING ========================= //
// ========================================================================= //
// Pine allows max 500 each of boxes, lines, labels.
// Check current usage via array sizes before creating new objects.

int BOX_LIMIT   = 490
int LINE_LIMIT  = 490
int LABEL_LIMIT = 490

f_boxes_used() =>
    array.size(bg_boxes) + array.size(candle_b) + array.size(fvg_boxes) + array.size(snd_boxes)

f_lines_used() =>
    array.size(candle_w) + array.size(ma1_lines) + array.size(ma2_lines)

f_labels_used() =>
    array.size(snd_labels)

f_draw_minichart(HTF_Data data, string tf_label, int level) =>
    if array.size(data.c) > 2
        float hv = ta.highest(high, 300)
        float lv = ta.lowest(low, 300)
        float cr = hv - lv == 0 ? syminfo.mintick * 100 : hv - lv
        float my = (hv + lv) / 2
        float er = cr * i_vScale

        int   col_idx = level % 2
        int   row_idx = int(level / 2)
        float row_gap = er * i_vBuffer
        float bh      = (er - row_gap * 2) / 3

        // --- Vertical anchor: Top / Middle / Bottom + fine-tune nudge ---
        float nudge   = cr * i_vNudge
        float anchor_y = i_vPos == "Top"    ? hv + nudge
                       : i_vPos == "Bottom" ? lv + er + nudge
                       : my + er / 2 + nudge
        float top_y   = anchor_y - row_idx * (bh + row_gap)
        float bot_y   = top_y - bh

        // --- Horizontal anchor: Right (future space) / Left (over history) ---
        int total_w = 2 * i_width + i_gapX
        int start_x = i_hPos == "Right"
             ? bar_index + i_offset + col_idx * (i_width + i_gapX)
             : bar_index - i_offset - total_w + col_idx * (i_width + i_gapX)
        int end_x   = start_x + i_width

        float itop = top_y - bh * 0.02
        float ibot = bot_y + bh * 0.02
        float ir   = itop - ibot

        float max_h = array.max(data.h)
        float min_l = array.min(data.l)
        float hr    = max_h - min_l == 0 ? syminfo.mintick : max_h - min_l

        // Background box with TF label
        if f_boxes_used() < BOX_LIMIT
            array.push(bg_boxes, box.new(start_x, top_y, end_x, bot_y,
                 border_color=c_border, bgcolor=c_bg,
                 text=f_format_tf(tf_label),
                 text_color=c_text, text_halign=text.align_center,
                 text_valign=text.align_bottom, text_size=size.small))

        int   n  = array.size(data.c)
        float bs = float(i_width) / math.max(n, 1)

        float[] m1v = show_ma1 ? f_calc_ma(data.c, ma1_type, ma1_len) : array.new_float(0)
        float[] m2v = show_ma2 ? f_calc_ma(data.c, ma2_type, ma2_len) : array.new_float(0)

        int fbc = 0, int fcc = 0

        // ==========================================================
        // --- S&D ZONES (drawn before candles so candles sit on top)
        // ==========================================================
        if show_snd
            [sz_top, sz_btm, sz_isDem, sz_barIdx] = f_detect_snd(data)
            int szCount = array.size(sz_top)

            if szCount > 0
                int demDrawn = 0
                int supDrawn = 0

                // Iterate from most recent zone to oldest (last pushed = most recent)
                for z = szCount - 1 to 0
                    bool zIsDem = array.get(sz_isDem, z)
                    if zIsDem and demDrawn >= max_snd
                        continue
                    if not zIsDem and supDrawn >= max_snd
                        continue

                    float zTop = array.get(sz_top, z)
                    float zBtm = array.get(sz_btm, z)
                    int   zBi  = array.get(sz_barIdx, z)

                    // Map zone prices to mini chart y-coordinates
                    float mappedTop = ibot + ((zTop - min_l) / hr) * ir
                    float mappedBtm = ibot + ((zBtm - min_l) / hr) * ir

                    // Map zone creation bar to x-position within the mini chart
                    int drawI   = n - 1 - zBi
                    int zone_x1 = end_x - int(drawI * bs)
                    int zone_x2 = end_x

                    if f_boxes_used() < BOX_LIMIT
                        color zCol = zIsDem ? c_snd_demand : c_snd_supply
                        array.push(snd_boxes, box.new(zone_x1, mappedTop, zone_x2, mappedBtm,
                             bgcolor=zCol, border_color=na))

                    // Price labels at proximal and distal edges
                    if show_snd_price and f_labels_used() < LABEL_LIMIT - 1
                        string pSz = snd_price_size == "Small" ? size.small : snd_price_size == "Normal" ? size.normal : snd_price_size == "Large" ? size.large : size.tiny
                        color  pCol = zIsDem ? color.new(#00C853, 0) : color.new(#FF1744, 0)

                        // Proximal (entry) price
                        float proxPrice  = zIsDem ? zTop : zBtm
                        float mappedProx = zIsDem ? mappedTop : mappedBtm
                        array.push(snd_labels, label.new(
                             zone_x2, mappedProx, str.tostring(proxPrice, format.mintick),
                             color     = color.new(color.white, 100),
                             textcolor = pCol,
                             style     = zIsDem ? label.style_label_lower_left : label.style_label_upper_left,
                             size      = pSz))

                        // Distal (SL) price
                        if f_labels_used() < LABEL_LIMIT
                            float distPrice  = zIsDem ? zBtm : zTop
                            float mappedDist = zIsDem ? mappedBtm : mappedTop
                            array.push(snd_labels, label.new(
                                 zone_x2, mappedDist, str.tostring(distPrice, format.mintick),
                                 color     = color.new(color.white, 100),
                                 textcolor = pCol,
                                 style     = zIsDem ? label.style_label_upper_left : label.style_label_lower_left,
                                 size      = pSz))

                    if zIsDem
                        demDrawn += 1
                    else
                        supDrawn += 1

        // ==================
        // --- CANDLES ---
        // ==================
        for i = 0 to n - 1
            int   idx = n - 1 - i
            float _o  = array.get(data.o, idx)
            float _h  = array.get(data.h, idx)
            float _l  = array.get(data.l, idx)
            float _c  = array.get(data.c, idx)

            float so = ibot + ((_o - min_l) / hr) * ir
            float sh = ibot + ((_h - min_l) / hr) * ir
            float sl = ibot + ((_l - min_l) / hr) * ir
            float sc = ibot + ((_c - min_l) / hr) * ir

            int   xp  = end_x - int(i * bs)

            // --- Range-based candle coloring ---
            color col = _c >= _o ? c_up : c_down
            if show_range
                float _cBody  = math.abs(_c - _o)
                float _cRange = _h - _l
                float _cRatio = _cRange > 0 ? (_cBody / _cRange) * 100.0 : 0.0
                bool  _isUp   = _c >= _o
                if _cRatio >= 70.0
                    col := _isUp ? c_r3_up : c_r3_down
                else if _cRatio >= 50.0
                    col := _isUp ? c_r2_up : c_r2_down

            if f_lines_used() < LINE_LIMIT
                array.push(candle_w, line.new(xp, sh, xp, sl, color=col))
            if f_boxes_used() < BOX_LIMIT
                array.push(candle_b, box.new(xp - 1, so, xp + 1, sc, border_color=col, bgcolor=col))

            // --- MAs ---
            if i < n - 1
                int nxp  = end_x - int((i + 1) * bs)
                int nidx = idx - 1
                if show_ma1 and f_lines_used() < LINE_LIMIT
                    float v1 = array.get(m1v, idx)
                    float v2 = array.get(m1v, nidx)
                    if not na(v1) and not na(v2)
                        array.push(ma1_lines, line.new(xp, ibot + ((v1 - min_l) / hr) * ir,
                             nxp, ibot + ((v2 - min_l) / hr) * ir, color=c_ma1, width=1))
                if show_ma2 and f_lines_used() < LINE_LIMIT
                    float v1 = array.get(m2v, idx)
                    float v2 = array.get(m2v, nidx)
                    if not na(v1) and not na(v2)
                        array.push(ma2_lines, line.new(xp, ibot + ((v1 - min_l) / hr) * ir,
                             nxp, ibot + ((v2 - min_l) / hr) * ir, color=c_ma2, width=1))

            // --- FVGs ---
            if show_fvg and idx >= 2
                float _l2 = array.get(data.l, idx - 2)
                float _h2 = array.get(data.h, idx - 2)
                if _l > _h2 and fbc < max_fvg and f_boxes_used() < BOX_LIMIT
                    array.push(fvg_boxes, box.new(xp, ibot + ((_l  - min_l) / hr) * ir,
                         end_x,    ibot + ((_h2 - min_l) / hr) * ir, bgcolor=c_fvg_bull, border_color=na))
                    fbc += 1
                if _h < _l2 and fcc < max_fvg and f_boxes_used() < BOX_LIMIT
                    array.push(fvg_boxes, box.new(xp, ibot + ((_l2 - min_l) / hr) * ir,
                         end_x,    ibot + ((_h  - min_l) / hr) * ir, bgcolor=c_fvg_bear, border_color=na))
                    fcc += 1

// ========================================================================= //
// ========================= CONDITIONAL RENDERING ========================= //
// ========================================================================= //
// Enabled charts pack into consecutive grid slots (no empty gaps).

if barstate.islast
    f_cleanup()
    int lvl = 0
    if tf1_on
        f_draw_minichart(data1, tf1, lvl)
        lvl += 1
    if tf2_on
        f_draw_minichart(data2, tf2, lvl)
        lvl += 1
    if tf3_on
        f_draw_minichart(data3, tf3, lvl)
        lvl += 1
    if tf4_on
        f_draw_minichart(data4, tf4, lvl)
        lvl += 1
    if tf5_on
        f_draw_minichart(data5, tf5, lvl)
        lvl += 1
    if tf6_on
        f_draw_minichart(data6, tf6, lvl)
        lvl += 1
